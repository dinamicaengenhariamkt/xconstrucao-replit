# JWT Secret for signing tokens (REQUIRED)
# Generate a secure random string with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-here-min-32-characters

# Google OAuth (Configure at: https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Trusted proxy gate (rate-limit por IP).
# Defina como "1" quando o app roda atrás de um proxy confiável (Replit, Vercel, Cloudflare).
# Sem isso, o tier IP do rate-limit fica neutralizado em dev (tiers user/thread continuam ativos).
# Em produção, deixar setado pra evitar spoof de X-Forwarded-For.
TRUST_PROXY_HEADERS=

# Sentry — Observabilidade técnica (J33)
# Obter em: sentry.io → Settings → Projects → <projeto> → Client Keys (DSN)
SENTRY_DSN=
# Mesmo DSN, exposto ao browser
NEXT_PUBLIC_SENTRY_DSN=
# Token para upload de source maps no build (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
# Nome da org e projeto no Sentry (não são segredos)
SENTRY_ORG=xconstrucao
SENTRY_PROJECT=xconstrucao-web

# ── Gateway de pagamento — Asaas (J11/J14) ───────────────────────────────────
# Seletor do adapter de cobrança. "manual" ativa assinaturas sem cobrança real
# (default de dev/E2E) e é BLOQUEADO em produção. Em produção, definir "asaas".
PAYMENT_GATEWAY=manual
# Ambiente da API Asaas: "sandbox" (default) ou "production".
ASAAS_ENVIRONMENT=sandbox
# Chave de API do Asaas (Painel Asaas → Integrações → API Key). REQUIRED quando
# PAYMENT_GATEWAY=asaas. Segredo — nunca commitar o valor real.
ASAAS_API_KEY=
# Token do webhook do Asaas (Painel Asaas → Integrações → Webhooks → Token de
# autenticação). Auth PRIMÁRIA e criptográfica do webhook: enviado no header
# `asaas-access-token` e validado em tempo constante. RECOMENDADO em produção —
# é o que impede um POST forjado de confirmar pagamento sem pagar. Com
# MARKETPLACE_SPLIT=on, defina ESTE token OU ASAAS_WEBHOOK_IPS (senão o webhook
# é recusado — fail-closed).
ASAAS_WEBHOOK_TOKEN=
# IPs oficiais de webhook do Asaas, separados por vírgula (whitelist — defesa
# secundária, spoofável via X-Forwarded-For se o proxy não sanear o header).
# Consultar a doc do Asaas para a lista atual de IPs de origem.
ASAAS_WEBHOOK_IPS=
# URL pública base da aplicação (ex: https://xconstrucao.com.br). Usada para
# montar successUrl/cancelUrl do checkout hospedado. REQUIRED em produção.
NEXT_PUBLIC_BASE_URL=
# Nota go-live: apontar o webhook do Asaas para POST /api/webhooks/gateway
# e manter TRUST_PROXY_HEADERS=1 (acima) para resolver o IP de origem corretamente.

# ── Marketplace split — recebimento do empreiteiro (J42–J50) ─────────────────
# Liga a frente de marketplace/split (subconta do empreiteiro, split de obra).
# "on" habilita; qualquer outro valor mantém desligado (default). A UI de
# "Dados de recebimento" só aparece com isto ligado E PAYMENT_GATEWAY=asaas.
MARKETPLACE_SPLIT=off
# Chave de criptografia em repouso (AES-256-GCM) da apiKey da subconta Asaas.
# 32 bytes em hex (64 chars). DEVE ser estável em produção — rotacioná-la torna
# os segredos já cifrados indecifráveis. REQUIRED quando MARKETPLACE_SPLIT=on.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPLACE_ENC_KEY=
