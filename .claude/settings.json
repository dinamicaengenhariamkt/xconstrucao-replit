{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(drizzle-kit drop:*)",
      "Bash(drizzle-kit migrate:*)",
      "Bash(npx drizzle-kit drop:*)",
      "Bash(npx drizzle-kit migrate:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-on-stop.sh"
          }
        ]
      }
    ]
  }
}
